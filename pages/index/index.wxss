.container {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.icon-wrap {
  margin-bottom: 24rpx;
}

.icon {
  font-size: 80rpx;
}

.survey-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.survey-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.meta-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.meta-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.meta-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: var(--color-border);
}

.privacy-card {
  padding: 28rpx 32rpx;
}

.privacy-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.privacy-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.btn-start {
  width: 100%;
  margin-top: 16rpx;
}
