.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  gap: 32rpx;
}

.success-card {
  width: 100%;
  text-align: center;
  padding: 64rpx 40rpx;
}

.check-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.success-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.btn-home {
  width: 100%;
}
